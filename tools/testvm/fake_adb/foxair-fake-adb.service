[Unit]
Description=FoxAir PHNIX Fake ADB Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=foxair-adb
Group=foxair-adb
EnvironmentFile=-/etc/default/foxair-fake-adb
ExecStart=/usr/bin/python3 /opt/foxair-fake-adb/foxair_fake_adb_server.py
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/foxair-fake-adb
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
