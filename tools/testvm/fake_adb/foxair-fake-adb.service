[Unit]
Description=FoxAir PHNIX Fake ADB Server for existing QEMU lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated TestVM: adb shell is intentionally an unrestricted Debian root shell.
# /data and /cache point at the Work QEMU rootfs; PHNIX-specific process queries
# are adapted by qemu_permissive_backend.py.
User=root
Group=root
EnvironmentFile=-/etc/default/foxair-fake-adb
ExecStart=/usr/bin/python3 /opt/foxair-fake-adb/foxair_fake_adb_server.py
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
