#!/bin/sh
set -eu

CONFIG=/etc/default/foxair-fake-adb
INSTALL_DIR=${FOXAIR_FAKE_ADB_INSTALL_DIR:-/opt/foxair-fake-adb}
ADAPTER="$INSTALL_DIR/qemu_lab_adapter.py"
SERVICE=foxair-fake-adb.service

if [ -f "$CONFIG" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONFIG"
    set +a
fi

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Bitte mit sudo ausführen: sudo foxair-fake-adbctl $*" >&2
        exit 2
    fi
}

adapter() {
    need_root "$@"
    python3 "$ADAPTER" "$@"
}

usage() {
    cat <<'EOF'
FoxAir Fake ADB / QEMU-Lab Control

Befehle:
  status                         ADB-Service, QEMU-RootFS, ARM-Dienst und Scenario-Bridge anzeigen
  scenario NAME                  OTA-Szenario im QEMU/Mainboard-Emulator setzen
  reset [NAME]                   Scenario-Zustand zurücksetzen (Default: success)
  online                         ADB-Gerät online melden (QEMU-Prozess bleibt unverändert)
  offline                        ADB-Gerät offline melden (QEMU-Prozess bleibt unverändert)
  simulator-start [NAME]         Alias: ADB online; optional danach Scenario NAME setzen
  simulator-stop                 Alias: ADB offline; beendet NICHT phnixIot4G/QEMU
  cancel-scenario NAME           Cancel-Szenario im Emulator setzen
  handshake-scenario NAME        Pre-C5A8-Handshake-Szenario im Emulator setzen
  same-version-scenario NAME     Same-Version-Szenario im Emulator setzen
  restart                        Nur den Fake-ADB-Systemdienst neu starten
  logs                           Live-Log des Fake-ADB-Servers anzeigen
  info                           Windows-Verbindungsdaten + QEMU-Backend anzeigen

Scenario-Steuerung:
  Der Adapter sucht zuerst FOXAIR_QEMU_SCENARIO_SOCKET, dann
  FOXAIR_QEMU_SCENARIO_HOOK und danach bekannte *scenario*ctl-/labctl-Namen
  unter /opt/phnix-lab/tools. Der Zustand wird zusätzlich in
  /opt/phnix-lab/control/foxair-ota-scenario.json dokumentiert.

  Wenn kein Emulator-Control-Endpunkt gefunden wird, wird der Zustand zwar
  gespeichert, der Befehl endet aber absichtlich mit Exit 3. Damit wird niemals
  fälschlich behauptet, das laufende Mainboard-Modell sei umgeschaltet worden.
EOF
}

cmd=${1:-status}
shift || true
case "$cmd" in
    status)
        need_root status
        systemctl --no-pager --full status "$SERVICE" || true
        echo
        adapter status
        ;;
    scenario|cancel-scenario|handshake-scenario|same-version-scenario)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        adapter "$cmd" "$1"
        ;;
    reset)
        adapter reset "${1:-success}"
        ;;
    online)
        adapter online
        ;;
    offline)
        adapter offline
        ;;
    simulator-start)
        adapter online
        if [ "$#" -eq 1 ]; then
            adapter scenario "$1"
        elif [ "$#" -gt 1 ]; then
            usage
            exit 2
        fi
        ;;
    simulator-stop)
        [ "$#" -eq 0 ] || { usage; exit 2; }
        adapter offline
        ;;
    restart)
        need_root restart
        systemctl restart "$SERVICE"
        systemctl --no-pager --full status "$SERVICE"
        ;;
    logs)
        need_root logs
        journalctl -u "$SERVICE" -f
        ;;
    info)
        need_root info
        port=${FOXAIR_FAKE_ADB_PORT:-5038}
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        echo "VM-IP: ${ip:-<VM-IP>}"
        echo "ADB-Port: $port"
        echo "Windows GUI: Remote ADB Server aktivieren, IP=${ip:-<VM-IP>}, Port=$port"
        echo "PowerShell: \$env:ADB_SERVER_SOCKET=\"tcp:${ip:-<VM-IP>}:$port\""
        echo
        adapter status
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unbekannter Befehl: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac
