#!/bin/sh
set -eu

CONFIG=/etc/default/foxair-fake-adb
INSTALL_DIR=${FOXAIR_FAKE_ADB_INSTALL_DIR:-/opt/foxair-fake-adb}
# qemu_lab_adapter.py remains the rootfs/process base; this wrapper invokes the
# Work-VM runtime layer that starts run_scenario_lab.sh and emulates ADB shell.
ADAPTER="$INSTALL_DIR/qemu_work_lab_backend.py"
SERVICE=foxair-fake-adb.service

if [ -f "$CONFIG" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$CONFIG"
    set +a
fi

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "Bitte mit sudo ausführen: sudo foxair-fake-adbctl $*" >&2
        exit 2
    fi
}

adapter() {
    need_root "$@"
    python3 "$ADAPTER" "$@"
}

usage() {
    cat <<'EOF'
FoxAir Fake ADB / Work-QEMU-Lab Control

Befehle:
  status                         ADB + echtes QEMU-RootFS + laufenden Lab-Runner anzeigen
  scenario NAME                  run_scenario_lab.sh mit passender RS485-Störung neu starten
  reset [NAME]                   Szenariozustand zurücksetzen und Lab-Runner neu starten
  runner-stop                    laufenden run_scenario_lab.sh sauber stoppen
  online / offline               nur die ADB-Sicht umschalten
  simulator-start [NAME]         Alias für online + optional scenario NAME
  simulator-stop                 Alias für offline; beendet NICHT phnixIot4G/QEMU
  cancel-scenario NAME           vorhandene Cancel-ACK-Funktion des RS485-Fakers verwenden
  handshake-scenario NAME        vorhandene C350/C357-Fehlerbilder verwenden
  same-version-scenario NAME     vorhandene C350-Status0/Status1-Fehlerbilder verwenden
  restart                        nur Fake-ADB-Systemdienst neu starten
  logs                           Fake-ADB-Log verfolgen
  lab-log                        Ausgabe des aktuell gestarteten Work-Lab-Runners verfolgen
  info                           Windows-Verbindungsdaten + Backendstatus

Direkt auf dem vorhandenen Work-Lab abbildbar:
  scenario success
  scenario same-version          -> FAULT_SCENARIO=c350-status0
  scenario stall-c350            -> FAULT_SCENARIO=no-c350-status
  scenario stall-c5a8            -> FAULT_SCENARIO=no-block-ack
  handshake-scenario success
  handshake-scenario missing-status-2 -> no-c357-status
  same-version-scenario success  -> c350-status0
  same-version-scenario status-1 -> success
  cancel-scenario success        -> CANCEL_ACK=1
  cancel-scenario no-response    -> CANCEL_ACK=0

Nicht direkt durch rs485_fault_emulator.py unterstützte alte Python-Simulator-
Szenarien werden absichtlich mit Exit 3 abgelehnt statt nur ungefähr emuliert.
EOF
}

cmd=${1:-status}
shift || true
case "$cmd" in
    status)
        need_root status
        systemctl --no-pager --full status "$SERVICE" || true
        echo
        adapter status
        ;;
    scenario|cancel-scenario|handshake-scenario|same-version-scenario)
        [ "$#" -eq 1 ] || { usage; exit 2; }
        adapter "$cmd" "$1"
        ;;
    reset)
        adapter reset "${1:-success}"
        ;;
    runner-stop)
        adapter runner-stop
        ;;
    online)
        adapter online
        ;;
    offline)
        adapter offline
        ;;
    simulator-start)
        adapter online
        if [ "$#" -eq 1 ]; then
            adapter scenario "$1"
        elif [ "$#" -gt 1 ]; then
            usage
            exit 2
        fi
        ;;
    simulator-stop)
        [ "$#" -eq 0 ] || { usage; exit 2; }
        adapter offline
        ;;
    restart)
        need_root restart
        systemctl restart "$SERVICE"
        systemctl --no-pager --full status "$SERVICE"
        ;;
    logs)
        need_root logs
        journalctl -u "$SERVICE" -f
        ;;
    lab-log)
        need_root lab-log
        tail -n 100 -f "${FOXAIR_FAKE_ADB_STATE:-/var/lib/foxair-fake-adb}/qemu-adb/scenario-lab.out"
        ;;
    info)
        need_root info
        port=${FOXAIR_FAKE_ADB_PORT:-5038}
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        echo "VM-IP: ${ip:-<VM-IP>}"
        echo "ADB-Port: $port"
        echo "Windows GUI: Remote ADB Server aktivieren, IP=${ip:-<VM-IP>}, Port=$port"
        echo "PowerShell: \$env:ADB_SERVER_SOCKET=\"tcp:${ip:-<VM-IP>}:$port\""
        echo
        adapter status
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unbekannter Befehl: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac
