make_c350_probe_gdb_script() {
    JSON=$(tr -d '\r\n' < "$COMMAND")
    ESCAPED=$(printf '%s' "$JSON" | sed 's/\\/\\\\/g; s/"/\\"/g')
    cat > "$GDB_SCRIPT" <<EOF
set architecture arm
set pagination off
set confirm off
set print thread-events off
set auto-load safe-path /
set libthread-db-search-path /lib
handle SIGILL nostop noprint pass
handle SIGFPE nostop noprint pass
file /data/phnixIot4G
target remote 127.0.0.1:12345
set \$c350_seen = 0
set \$injection_state = 0
set \$quiet_hits = 0

break *0x1fdac
commands 1
  silent
  if \$injection_state == 0
    if *(unsigned int *)0x930dc == 0 && *(unsigned char *)0x98a94 == 12
      set \$quiet_hits = \$quiet_hits + 1
    else
      set \$quiet_hits = 0
    end
    if \$quiet_hits >= 5
      set \$injection_state = 1
      set \$return_pc = \$pc
      set {char[512]} 0x94ab4 = "$ESCAPED"
      shell echo '{"phase":"c350-parser-injection","terminal":false,"quiet_hits":5}' > $STATUS
      set \$r0 = 0x94ab4
      set \$lr = \$return_pc
      set \$pc = 0x19958
    end
  else
    if \$injection_state == 1
      set \$injection_state = 2
      disable 1
    end
  end
  continue
end

break *0x1c4bc
commands 2
  silent
  set \$c350_seen = 1
  shell echo '{"phase":"c350-sent","terminal":false,"c350_sent":true}' > $STATUS
  continue
end

break *0x1ba04
commands 3
  silent
  if \$c350_seen == 1 && *(unsigned char *)(\$r0+1) == 0x63 && *(unsigned char *)(\$r0+3) == 0
    shell $0 _restore-state --status $STATUS
    shell echo '{"phase":"c350-same-version","terminal":true,"c350_sent":true,"c36e_status":0,"ssid_match":true,"c357_sent":false,"c5a8_sent":false,"state_restored":true,"recovery_required":false}' > $STATUS
    detach
    quit
  else
    shell echo '{"phase":"c36e-unexpected","terminal":false,"c350_sent":true,"recovery_required":true}' > $STATUS
    shell kill -STOP $PID
    detach
    quit
  end
end

break *0x1cea0
commands 4
  silent
  shell echo '{"phase":"forbidden-c357","terminal":false,"c350_sent":true,"c357_sent":false,"c5a8_sent":false,"recovery_required":true}' > $STATUS
  set \$pc = \$lr
  shell kill -STOP $PID
  detach
  quit
end

break *0x1c7cc
commands 5
  silent
  shell echo '{"phase":"forbidden-c5a8","terminal":false,"c350_sent":true,"c357_sent":false,"c5a8_sent":false,"recovery_required":true}' > $STATUS
  set \$pc = \$lr
  shell kill -STOP $PID
  detach
  quit
end

continue
EOF
}

