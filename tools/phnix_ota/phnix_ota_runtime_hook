cancel_probe_hook() {
    test "$LIVE_CONFIRM" = PHNIX-CANCEL-PROBE-0073 || fail "live cancel probe confirmation mismatch"
    verify
    command -v iptables >/dev/null 2>&1 || fail "iptables missing; cloud cannot be isolated"
    PID=$(service_pid)
    test "$(awk '/^TracerPid:/ {print $2}' /proc/$PID/status)" = 0 || fail "service is already traced"
    test "$(dd if=/data/phnixIot_device_OTA_INFO bs=1 skip=212 count=4 2>/dev/null | od -An -tu4 | tr -d ' ')" = 0 || fail "persistent OTA offset is not zero"
    test "$(dd if=/data/phnixIot_device_OTA_INFO bs=1 skip=216 count=4 2>/dev/null | od -An -tu4 | tr -d ' ')" = 0 || fail "persistent OTA length is not zero"
    mkdir -p "$STATE_DIR"
    rm -f "$SAFE_TO_CLEAN"
    touch "$RUN_ACTIVE"
    echo $$ > "$HELPER_PID"
    trap cleanup EXIT INT TERM
    watchdog_pids > "$WATCHDOG_PIDS"
    iptables -I OUTPUT -o rmnet_data0 -p tcp --dport 1883 -j DROP
    iptables -I INPUT -i rmnet_data0 -p tcp --sport 1883 -j DROP
    while read -r wd; do kill -STOP "$wd"; done < "$WATCHDOG_PIDS"
    make_cancel_probe_gdb_script
    printf '{"phase":"cancel-probe-attaching","terminal":false}\n' > "$STATUS"
    gdbserver --attach 127.0.0.1:12345 "$PID" > "$STATE_DIR/gdbserver-cancel-probe.log" 2>&1 &
    echo $! > "$GDBSERVER_PID"
    sleep 1
    gdb -q -batch -x "$GDB_SCRIPT" > "$STATE_DIR/cancel-probe.log" 2>&1 &
    echo $! > "$GDB_PID"
    wait "$(cat "$GDB_PID")"
}

cancel_probe_resume_hook() {
    test "$LIVE_CONFIRM" = PHNIX-CANCEL-PROBE-0073 || fail "live cancel probe confirmation mismatch"
    test -f "$RUN_ACTIVE" || fail "no guarded cancel probe to resume"
    PID=$(service_pid)
