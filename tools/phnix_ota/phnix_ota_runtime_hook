#!/bin/sh
# Build-specific runtime bridge for phnixIot4G.
# Target: ARM32 ELF Build-ID af4dcae12639bedce833ee5efa5da009777b6319
set -eu

SERVICE=/data/phnixIot4G
EXPECTED_SHA256=7c573431f0a67620d473419644a83a4f4dc04b8a91bde5923c74a63ba1eaedb7
STATE_DIR=/tmp/phnix_ota_hook
GDB_SCRIPT=$STATE_DIR/runtime.gdb
HELPER_PID=$STATE_DIR/helper.pid
GDB_PID=$STATE_DIR/gdb.pid
GDBSERVER_PID=$STATE_DIR/gdbserver.pid
WATCHDOG_PIDS=$STATE_DIR/watchdogs.pids
RUN_ACTIVE=$STATE_DIR/run.active
SAFE_TO_CLEAN=$STATE_DIR/safe-to-clean
STATE_BACKUP=$STATE_DIR/original-state
DEFAULT_STATUS=/tmp/phnix_ota_status.json

fail() {
    printf '{"phase":"error","terminal":true,"message":"%s"}\n' "$1" > "${STATUS:-$DEFAULT_STATUS}"
    echo "ERROR: $1" >&2
    exit 1
}

service_pid() {
    pidof phnixIot4G | awk '{print $1}'
}

watchdog_pids() {
    ps | awk '$4 == "{helloworld}" {print $1}'
}

verify() {
    test -x "$SERVICE" || fail "original service missing"
    ACTUAL_SHA256=$(sha256sum "$SERVICE" | awk '{print $1}')
    test "$ACTUAL_SHA256" = "$EXPECTED_SHA256" || fail "service build mismatch"
    test -x /usr/bin/gdb || fail "gdb missing"
    test -x /usr/bin/gdbserver || fail "gdbserver missing"
    busybox --list | grep -qx httpd || fail "busybox httpd missing"
    PID=$(service_pid)
    test -n "$PID" || fail "original service not running"
    WDS=$(watchdog_pids)
    test -n "$WDS" || fail "service watchdog not found"
    WDS_JSON=$(printf '%s\n' "$WDS" | awk 'BEGIN{s=""} {s=s sep $1; sep=","} END{print s}')
    TRACER=$(awk '/^TracerPid:/ {print $2}' "/proc/$PID/status")
    test "$TRACER" = 0 || fail "service is already traced"
    printf '{"phase":"verified","terminal":false,"service_pid":%s,"watchdogs":[%s]}\n' "$PID" "$WDS_JSON" > "${STATUS:-$DEFAULT_STATUS}"
    echo "verified service_pid=$PID watchdogs=$WDS sha256=$ACTUAL_SHA256"
}

resume_watchdogs() {
    if test -f "$WATCHDOG_PIDS"; then
        while read -r pid; do
            test -n "$pid" && kill -CONT "$pid" 2>/dev/null || true
        done < "$WATCHDOG_PIDS"
    fi
}

remove_cloud_guard() {
    if command -v iptables >/dev/null 2>&1; then
        iptables -D OUTPUT -o rmnet_data0 -p tcp --dport 1883 -j DROP 2>/dev/null || true
        iptables -D INPUT -i rmnet_data0 -p tcp --sport 1883 -j DROP 2>/dev/null || true
    fi
}

backup_persistent_state() {
    rm -rf "$STATE_BACKUP"
    mkdir -p "$STATE_BACKUP"
    cp -p /data/phnixIot_device_OTA_INFO "$STATE_BACKUP/OTA_INFO"
    cp -p /data/phnixIot_device_statisic "$STATE_BACKUP/statisic"
    test "$(wc -c < "$STATE_BACKUP/OTA_INFO")" = 220 || fail "OTA_INFO backup is not 220 bytes"
    sha256sum "$STATE_BACKUP/OTA_INFO" | awk '{print $1}' > "$STATE_BACKUP/OTA_INFO.sha256"
}

restore_persistent_state() {
    test -f "$STATE_BACKUP/OTA_INFO" || fail "OTA_INFO backup missing"
    test -f "$STATE_BACKUP/statisic" || fail "statistics backup missing"
    cp -p "$STATE_BACKUP/OTA_INFO" /data/.phnixIot_device_OTA_INFO.restore
    cp -p "$STATE_BACKUP/statisic" /data/.phnixIot_device_statisic.restore
    test "$(sha256sum /data/.phnixIot_device_OTA_INFO.restore | awk '{print $1}')" = "$(cat "$STATE_BACKUP/OTA_INFO.sha256")" || fail "OTA_INFO restore verification failed"
    mv /data/.phnixIot_device_OTA_INFO.restore /data/phnixIot_device_OTA_INFO
    mv /data/.phnixIot_device_statisic.restore /data/phnixIot_device_statisic
    sync
    test "$(sha256sum /data/phnixIot_device_OTA_INFO | awk '{print $1}')" = "$(cat "$STATE_BACKUP/OTA_INFO.sha256")" || fail "OTA_INFO post-restore verification failed"
    touch "$SAFE_TO_CLEAN"
}

cleanup_original_state() {
    if test -f "$GDB_PID"; then
        kill -INT "$(cat "$GDB_PID")" 2>/dev/null || true
    fi
    if test -f "$GDBSERVER_PID"; then
        kill -TERM "$(cat "$GDBSERVER_PID")" 2>/dev/null || true
    fi
    PID=$(service_pid || true)
    test -n "$PID" && kill -CONT "$PID" 2>/dev/null || true
    resume_watchdogs
    remove_cloud_guard
    rm -f "$HELPER_PID" "$GDB_PID" "$GDBSERVER_PID" "$RUN_ACTIVE" "$SAFE_TO_CLEAN"
}

cleanup() {
    if test -f "$RUN_ACTIVE" && ! test -f "$SAFE_TO_CLEAN"; then
        PID=$(service_pid || true)
        test -n "$PID" && kill -STOP "$PID" 2>/dev/null || true
        printf '{"phase":"guarded-hold","terminal":false,"recovery_required":true}\n' > "${STATUS:-$DEFAULT_STATUS}"
        echo "ACTIVE OTA LEFT IN GUARDED HOLD; CLOUD AND WATCHDOGS REMAIN BLOCKED" >&2
        return
    fi
    cleanup_original_state
}

stop_hook() {
    if test -f "$RUN_ACTIVE" && ! test -f "$SAFE_TO_CLEAN" && test "${FORCE:-0}" != 1; then
        fail "active OTA is not terminal; refusing unsafe cleanup"
    fi
    if test -f "$HELPER_PID"; then
        PID=$(cat "$HELPER_PID")
        test "$PID" != "$$" && kill -TERM "$PID" 2>/dev/null || true
    fi
    cleanup_original_state
    printf '{"phase":"stopped","terminal":true}\n' > "$STATUS"
}

