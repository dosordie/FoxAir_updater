#!/system/bin/sh
# Ephemeral, passive tracer for the one verified non-PIE ARM32 build.
set -u
STATE=/data/local/tmp/foxair-traffic
BIN=/data/phnixIot4G
EXPECTED_SHA256=7c573431f0a67620d473419644a83a4f4dc04b8a91bde5923c74a63ba1eaedb7
WATCHDOG_PIDS=$STATE/watchdogs.pids
GDB_INPUT=$STATE/gdb.input

pid_of_service() { pidof phnixIot4G 2>/dev/null | awk '{print $1}'; }
watchdog_pids() { ps | awk '$4 == "{helloworld}" {print $1}'; }

resume_watchdogs() {
  if test -f "$WATCHDOG_PIDS"; then
    while read -r wd; do test -n "$wd" && kill -CONT "$wd" 2>/dev/null || true; done < "$WATCHDOG_PIDS"
    rm -f "$WATCHDOG_PIDS"
  fi
}

freeze_watchdogs() {
  watchdog_pids > "$WATCHDOG_PIDS"
  test -s "$WATCHDOG_PIDS" || unsupported "keine {helloworld}-Watchdogs gefunden"
  while read -r wd; do test -n "$wd" && kill -STOP "$wd"; done < "$WATCHDOG_PIDS"
}
unsupported() {
  echo "Sicherheitsprüfung fehlgeschlagen: $1 – Runtime-Trace deaktiviert" >&2
  exit 3
}

verify_running_binary() {
  CHECK_PID=${1:-}
  test -n "$CHECK_PID" || unsupported "keine eindeutige phnixIot4G-PID"
  kill -0 "$CHECK_PID" 2>/dev/null || unsupported "PID $CHECK_PID ist nicht mehr aktiv"
  test "$(readlink "/proc/$CHECK_PID/exe" 2>/dev/null)" = "$BIN" || unsupported "Prozess $CHECK_PID verwendet nicht $BIN"
  test -r "/proc/$CHECK_PID/maps" || unsupported "/proc/$CHECK_PID/maps ist nicht lesbar"
  ACTUAL_SHA256=$(/bin/sha256sum "$BIN" 2>/dev/null | awk '{print $1}')
  test "$ACTUAL_SHA256" = "$EXPECTED_SHA256" || unsupported "SHA256 von $BIN ist ${ACTUAL_SHA256:-nicht ermittelbar}, erwartet $EXPECTED_SHA256"
}

stop_debuggers() {
  if test -r "$STATE/gdb.pid" && kill -0 "$(cat "$STATE/gdb.pid")" 2>/dev/null; then
    # Interrupt `continue`, then let the same GDB session detach cleanly.
    kill -INT "$(cat "$STATE/gdb.pid")" 2>/dev/null || true
    test -p "$GDB_INPUT" && printf 'detach\nquit\n' > "$GDB_INPUT" || true
    COUNT=0
    while kill -0 "$(cat "$STATE/gdb.pid")" 2>/dev/null && test "$COUNT" -lt 10; do sleep 1; COUNT=$((COUNT + 1)); done
    kill -TERM "$(cat "$STATE/gdb.pid")" 2>/dev/null || true
  fi
  test -r "$STATE/gdb-input.pid" && kill "$(cat "$STATE/gdb-input.pid")" 2>/dev/null || true
  test -r "$STATE/gdbserver.pid" && kill -TERM "$(cat "$STATE/gdbserver.pid")" 2>/dev/null || true
}

emergency_cleanup() {
  stop_debuggers
  resume_watchdogs
}

stop_trace() {
  OLD_PID=$(cat "$STATE/service.pid" 2>/dev/null || true)
  mkdir -p "$STATE"
  trap emergency_cleanup EXIT INT TERM
  freeze_watchdogs
  stop_debuggers
  SAME_PID=$(pid_of_service)
  test -n "$OLD_PID" && test "$SAME_PID" = "$OLD_PID" && kill -0 "$OLD_PID" 2>/dev/null
  PID_OK=$?
  resume_watchdogs
  trap - EXIT INT TERM
  rm -f "$STATE/gdb.pid" "$STATE/gdb-input.pid" "$STATE/gdbserver.pid" "$STATE/active" "$GDB_INPUT"
  test "${1:-}" = --purge && rm -rf "$STATE"
  test "$PID_OK" -eq 0 || { echo "Stopfehler: phnixIot4G-PID ist nicht unverändert aktiv" >&2; return 7; }
}

startup_failed() {
  FAILED_COMPONENT=$1
  FAILED_LOG=$2
  echo "Startfehler: $FAILED_COMPONENT wurde innerhalb der Startprüfung beendet" >&2
  echo "--- $FAILED_LOG ---" >&2
  if test -r "$FAILED_LOG"; then cat "$FAILED_LOG" >&2; else echo "<Logdatei nicht lesbar>" >&2; fi
  # Stop surviving tracer processes, but deliberately retain all debug files.
  stop_trace
  exit 6
}

start_trace() {
  test "$#" -eq 0 || unsupported "unerwartete Startparameter"
  command -v gdb >/dev/null && command -v gdbserver >/dev/null || { echo "gdb/gdbserver missing" >&2; exit 4; }
  PID=$(pid_of_service); test -n "$PID" || { echo "phnixIot4G inactive" >&2; exit 5; }
  verify_running_binary "$PID"
  if test -r "$STATE/service.pid"; then
    stop_trace
  else
    emergency_cleanup
    rm -rf "$STATE"
  fi
  mkdir -p "$STATE"; : > "$STATE/events.jsonl"
  # This first implementation intentionally makes no claim that arbitrary
  # pointers are map-validated.  Every variable buffer is length-capped and a
  # failed debugger read only terminates the tracer. No process-memory write or
  # injected code is used.
  cat > "$STATE/trace.gdb" <<'EOF'
set architecture arm
set pagination off
set confirm off
set print thread-events off
set auto-load safe-path /
set libthread-db-search-path /lib
file /data/phnixIot4G
set logging file /data/local/tmp/foxair-traffic/raw.log
set logging overwrite off
set logging redirect on
set logging on
target remote 127.0.0.1:12346
break *0x1F6FC
commands
 silent
 if $r1 >= 0 && $r1 <= 65536 && $r0 > 0x1000
  printf "FOX|mqtt|tx|user/update|%u|0x%x|",$r1,$r0
  set $i=0
  while $i<$r1
   printf "%02x ",*(unsigned char*)($r0+$i)
   set $i=$i+1
  end
  printf "\n"
 end
 continue
end
break *0x1EED0
commands
 silent
 if $r2 > 0x1000 && *(unsigned int*)($r2+4) > 0x1000
  set $m=*(unsigned int*)($r2+4)
  if *(unsigned int*)($m+8) <= 65536 && *(unsigned int*)($m+16) > 0x1000
   set $n=*(unsigned int*)($m+8)
   set $p=*(unsigned int*)($m+16)
   printf "FOX|mqtt|rx|user/get|%u|0x%x|",$n,$p
   set $i=0
   while $i<$n
    printf "%02x ",*(unsigned char*)($p+$i)
    set $i=$i+1
   end
   printf "\n"
  end
 end
 continue
end
break *0x1ED98
commands
 silent
 if $r2 > 0x1000 && *(unsigned int*)($r2+4) > 0x1000
  set $m=*(unsigned int*)($r2+4)
  if *(unsigned int*)($m+8) <= 65536 && *(unsigned int*)($m+16) > 0x1000
   set $n=*(unsigned int*)($m+8)
   set $p=*(unsigned int*)($m+16)
   printf "FOX|mqtt|rx|ota|%u|0x%x|",$n,$p
   set $i=0
   while $i<$n
    printf "%02x ",*(unsigned char*)($p+$i)
    set $i=$i+1
   end
   printf "\n"
  end
 end
 continue
end
break *0x19A54
commands
 silent
 if $r1 <= 65536 && $r2 <= 65536 && $r1*$r2 <= 65536 && $r0 > 0x1000
  printf "FOX|http|rx|ota_chunk|%u|0x%x|\n",$r1*$r2,$r0
 end
 continue
end
break *0x1F9B0
commands
 silent
 if $r1 >= 0 && $r1 <= 65536 && $r0 > 0x1000
  printf "FOX|mqtt|tx|ota_update|%u|0x%x|",$r1,$r0
  set $i=0
  while $i<$r1
   printf "%02x ",*(unsigned char*)($r0+$i)
   set $i=$i+1
  end
  printf "\n"
 end
 continue
end
break *0x19E70
commands
 silent
 printf "META|ota_start|mainboard|/cache/phnixIot_device_OTA|%.1024s\n",(char*)0x933E1
 continue
end
break *0x19C18
commands
 silent
 printf "META|ota_start|dtu|/data/phnixIot4G_OTA|%.1024s\n",(char*)0x931A9
 continue
end
# Provisioning payload bodies deliberately never enter raw.log: response
# buffers can contain credentials. These hooks only record safe metadata.
break *0x16960
commands
 silent
 printf "META|provision|linked_go_queryiotdevice|http|%u\n",$r1*$r2
 continue
end
break *0x15C58
commands
 silent
 printf "META|provision|legacy_queryiotdevice|http|%u\n",$r1*$r2
 continue
end
break *0x164AC
commands
 silent
 printf "META|provision|linked_go_create_device_by_sign|http|0\n"
 continue
end
break *0x22FF4
commands
 silent
 printf "META|provision|aliyun_dynamic_register|https|0\n"
 continue
end
break *0x22B9C
commands
 silent
 printf "META|provision|aliyun_dynamic_register_response|https|0\n"
 continue
end
continue
EOF
  # Close the verification/attach race: the same PID, executable link, hash,
  # liveness and maps readability must still hold immediately before attach.
  test "$PID" = "$(pid_of_service)" || unsupported "phnixIot4G-PID hat sich vor dem Attach geändert"
  verify_running_binary "$PID"
  trap emergency_cleanup EXIT INT TERM
  freeze_watchdogs
  gdbserver --attach 127.0.0.1:12346 "$PID" >"$STATE/gdbserver.log" 2>&1 & echo $! > "$STATE/gdbserver.pid"
  sleep 1
  kill -0 "$(cat "$STATE/gdbserver.pid")" 2>/dev/null || startup_failed "gdbserver" "$STATE/gdbserver.log"
  rm -f "$GDB_INPUT"; mkfifo "$GDB_INPUT"
  gdb -q -batch -x "$STATE/trace.gdb" < "$GDB_INPUT" >"$STATE/gdb.log" 2>&1 & echo $! > "$STATE/gdb.pid"
  # Keep stdin open while tracing; stop_trace writes detach/quit to this FIFO.
  (while :; do sleep 3600; done) > "$GDB_INPUT" & echo $! > "$STATE/gdb-input.pid"
  sleep 1
  kill -0 "$(cat "$STATE/gdb.pid")" 2>/dev/null || startup_failed "gdb" "$STATE/gdb.log"
  test "$PID" = "$(pid_of_service)" && kill -0 "$PID" 2>/dev/null || startup_failed "phnixIot4G" "$STATE/gdb.log"
  echo "$PID" > "$STATE/service.pid"; touch "$STATE/active"; echo active
  resume_watchdogs
  trap - EXIT INT TERM
}

status_trace() {
  if test -r "$STATE/active" && test "$(cat "$STATE/service.pid" 2>/dev/null)" = "$(pid_of_service)" && kill -0 "$(cat "$STATE/gdbserver.pid")" 2>/dev/null && kill -0 "$(cat "$STATE/gdb.pid")" 2>/dev/null; then echo active; else echo inactive; fi
}

case "${1:-}" in
 start) shift; start_trace "$@" ;;
 stop) shift; stop_trace "${1:-}" ;;
 status) status_trace ;;
 *) echo "usage: $0 {start|stop [--purge]|status}" >&2; exit 2 ;;
esac
