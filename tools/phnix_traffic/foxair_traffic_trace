#!/system/bin/sh
# Ephemeral full-payload tracer for the one verified non-PIE ARM32 build.
set -u
STATE=/data/local/tmp/foxair-traffic
BIN=/data/phnixIot4G
EXPECTED_SHA256=7c573431f0a67620d473419644a83a4f4dc04b8a91bde5923c74a63ba1eaedb7
WATCHDOG_PIDS=$STATE/watchdogs.pids
PAYLOAD_MODE=full
RUN_ID_FILE=$STATE/run.id
GDB_INPUT=$STATE/gdb.input
MAX_TRACE_SECONDS=120

pid_of_service() { pidof phnixIot4G 2>/dev/null | awk '{print $1}'; }
watchdog_pids() { ps | awk '$4 == "{helloworld}" {print $1}'; }
unsupported() { echo "Sicherheitsprüfung fehlgeschlagen: $1 – Runtime-Trace deaktiviert" >&2; exit 3; }

resume_watchdogs() {
  if test -f "$WATCHDOG_PIDS"; then
    while read -r wd; do test -n "$wd" && kill -CONT "$wd" 2>/dev/null || true; done < "$WATCHDOG_PIDS"
    rm -f "$WATCHDOG_PIDS"
  fi
}
freeze_watchdogs() {
  watchdog_pids > "$WATCHDOG_PIDS"
  test -s "$WATCHDOG_PIDS" || unsupported "keine {helloworld}-Watchdogs gefunden"
  while read -r wd; do test -n "$wd" && kill -STOP "$wd"; done < "$WATCHDOG_PIDS"
}

verify_running_binary() {
  CHECK_PID=${1:-}
  test -n "$CHECK_PID" || unsupported "keine eindeutige phnixIot4G-PID"
  kill -0 "$CHECK_PID" 2>/dev/null || unsupported "PID $CHECK_PID ist nicht mehr aktiv"
  test "$(readlink "/proc/$CHECK_PID/exe" 2>/dev/null)" = "$BIN" || unsupported "Prozess $CHECK_PID verwendet nicht $BIN"
  test -r "/proc/$CHECK_PID/maps" || unsupported "/proc/$CHECK_PID/maps ist nicht lesbar"
  ACTUAL_SHA256=$(/bin/sha256sum "$BIN" 2>/dev/null | awk '{print $1}')
  test "$ACTUAL_SHA256" = "$EXPECTED_SHA256" || unsupported "SHA256 von $BIN ist ${ACTUAL_SHA256:-nicht ermittelbar}, erwartet $EXPECTED_SHA256"
}

remove_runtime_markers() {
  rm -f "$STATE/active" "$STATE/stopping" "$STATE/stop.request" "$STATE/guardian.pid" \
    "$STATE/gdb.pid" "$STATE/gdbserver.pid" "$STATE/monitor.pid" \
    "$STATE/service.pid" "$STATE/deadline" "$STATE/max-seconds" "$STATE/gdb.input" \
    "$STATE"/*.fifo "$STATE"/*.pipe
}

recover_stale_markers() {
  test -f "$STATE/active" || return 0
  GDB_PID=$(cat "$STATE/gdb.pid" 2>/dev/null || true)
  GDBSERVER_PID=$(cat "$STATE/gdbserver.pid" 2>/dev/null || true)
  if { test -n "$GDB_PID" && kill -0 "$GDB_PID" 2>/dev/null; } \
    || { test -n "$GDBSERVER_PID" && kill -0 "$GDBSERVER_PID" 2>/dev/null; }; then
    unsupported "ein Trace ist bereits aktiv oder wartet auf sicheren manuellen Detach"
  fi
  PID=$(pid_of_service)
  test -n "$PID" && kill -0 "$PID" 2>/dev/null \
    || unsupported "verwaister Trace-Marker, aber phnixIot4G ist nicht aktiv"
  test -n "$(watchdog_pids)" \
    || unsupported "verwaister Trace-Marker, aber die Watchdogs laufen nicht"
  echo "Verwaisten Trace-Marker ohne laufenden Debugger entfernt" >> "$STATE/helper.log"
  remove_runtime_markers
}

# Legacy GDB cannot reliably interrupt its asynchronous remote CLI. Teardown
# terminates GDB and gdbserver, then trusts only the kernel's TracerPid state.
stop_debuggers() {
  GDB_PID=$(cat "$STATE/gdb.pid" 2>/dev/null || true)
  test -n "$GDB_PID" || return 0
  DETACH_OK=1
  RUN_ID=$(cat "$RUN_ID_FILE" 2>/dev/null)
  SERVICE_PID=$(cat "$STATE/service.pid" 2>/dev/null || true)
  kill -TERM "$GDB_PID" 2>/dev/null || true
  sleep 1
  GDBSERVER_PID=$(cat "$STATE/gdbserver.pid" 2>/dev/null || true)
  test -z "$GDBSERVER_PID" || kill -TERM "$GDBSERVER_PID" 2>/dev/null || true
  COUNT=0
  while test "$COUNT" -lt 10; do
    TRACER_PID=$(awk '/^TracerPid:/{print $2}' "/proc/$SERVICE_PID/status" 2>/dev/null || true)
    test "$TRACER_PID" = 0 && break
    sleep 1; COUNT=$((COUNT + 1))
  done
  if test "$TRACER_PID" = 0 && test "$SERVICE_PID" = "$(pid_of_service)"; then
    printf 'FOX|detached|run_id=%s\n' "$RUN_ID" >> "$STATE/raw.log"
    DETACH_OK=0
  fi
  if test "$DETACH_OK" -ne 0; then
    echo "run_id=$(cat "$RUN_ID_FILE" 2>/dev/null) KRITISCH: Zielstillstand/Detach nicht bestätigt; GDB und gdbserver bleiben unangetastet" >> "$STATE/helper.log"
  fi
  return "$DETACH_OK"
}

emergency_cleanup() {
  stop_debuggers || echo "run_id=$(cat "$RUN_ID_FILE" 2>/dev/null) Detach nicht bestätigt; Original-Watchdogs übernehmen die Wiederherstellung" >> "$STATE/helper.log"
  resume_watchdogs
  remove_runtime_markers
}

critical_failure() {
  REASON=$1
  OLD_PID=$(cat "$STATE/service.pid" 2>/dev/null || true)
  NEW_PID=$(pid_of_service)
  printf 'critical|%s|run_id=%s|old_pid=%s|new_pid=%s|hooks=%s\n' "$REASON" "$(cat "$RUN_ID_FILE" 2>/dev/null)" "$OLD_PID" "${NEW_PID:-none}" \
    "$(tr '\n' ',' < "$STATE/hooks" 2>/dev/null | sed 's/,$//')" > "$STATE/failure"
  echo "KRITISCH: $REASON (PID alt=$OLD_PID, PID neu=${NEW_PID:-none})" >> "$STATE/helper.log"
  emergency_cleanup
}

monitor_trace() {
  while test -f "$STATE/active"; do
    if test -f "$STATE/stop.request"; then
      stop_trace
      return
    fi
    OLD_PID=$(cat "$STATE/service.pid" 2>/dev/null || true)
    NEW_PID=$(pid_of_service)
    if test -z "$OLD_PID" || test "$OLD_PID" != "$NEW_PID" || ! kill -0 "$OLD_PID" 2>/dev/null; then
      critical_failure pid_changed
      return
    fi
    if grep -E 'Program received signal SIGSEGV|received signal SIGSEGV' "$STATE/gdb.log" "$STATE/raw.log" >/dev/null 2>&1; then
      critical_failure sigsegv
      return
    fi
    GDB_PID=$(cat "$STATE/gdb.pid" 2>/dev/null || true)
    if test -z "$GDB_PID" || ! kill -0 "$GDB_PID" 2>/dev/null; then
      critical_failure debugger_exited
      return
    fi
    DEADLINE=$(cat "$STATE/deadline" 2>/dev/null || echo 0)
    if test "$(date +%s)" -ge "$DEADLINE"; then
      echo "run_id=$(cat "$RUN_ID_FILE") maximale Laufzeit erreicht" >> "$STATE/helper.log"
      stop_trace
      return
    fi
    sleep 1
  done
}

wait_service_running() {
  CHECK_PID=$1
  kill -CONT "$CHECK_PID" 2>/dev/null || true
  COUNT=0
  while test "$COUNT" -lt 10; do
    STATE_CODE=$(awk '/^State:/{print $2}' "/proc/$CHECK_PID/status" 2>/dev/null || true)
    test -n "$STATE_CODE" && test "$STATE_CODE" != T && test "$STATE_CODE" != Z && return 0
    sleep 1
    COUNT=$((COUNT + 1))
  done
  return 1
}

stop_trace() {
  if test ! -f "$STATE/active" && test ! -f "$STATE/stopping"; then
    GDB_PID=$(cat "$STATE/gdb.pid" 2>/dev/null || true)
    GDBSERVER_PID=$(cat "$STATE/gdbserver.pid" 2>/dev/null || true)
    if { test -z "$GDB_PID" || ! kill -0 "$GDB_PID" 2>/dev/null; } \
      && { test -z "$GDBSERVER_PID" || ! kill -0 "$GDBSERVER_PID" 2>/dev/null; }; then
      resume_watchdogs
      remove_runtime_markers
      test "${1:-}" = --purge && rm -rf "$STATE"
      echo stopped
      return 0
    fi
  fi
  GUARDIAN_PID=$(cat "$STATE/guardian.pid" 2>/dev/null || true)
  if test -f "$STATE/active" && test -n "$GUARDIAN_PID" && test "$GUARDIAN_PID" != "$$" \
    && kill -0 "$GUARDIAN_PID" 2>/dev/null; then
    touch "$STATE/stop.request"
    COUNT=0
    while { test -f "$STATE/active" || test -f "$STATE/stopping"; } && test "$COUNT" -lt 45; do
      sleep 1; COUNT=$((COUNT + 1))
    done
    test ! -f "$STATE/active" && test ! -f "$STATE/stopping" \
      || { echo "Stopfehler: Guardian hat die Stop-Anforderung nicht abgeschlossen" >&2; return 7; }
    echo stopped
    return 0
  fi
  OLD_PID=$(cat "$STATE/service.pid" 2>/dev/null || true)
  mkdir -p "$STATE"
  trap emergency_cleanup EXIT INT TERM
  freeze_watchdogs
  touch "$STATE/stopping"
  rm -f "$STATE/active"
  STOP_OK=0
  stop_debuggers || STOP_OK=1
  SAME_PID=$(pid_of_service)
  if test -z "$OLD_PID" || test "$SAME_PID" != "$OLD_PID" || ! kill -0 "$OLD_PID" 2>/dev/null; then STOP_OK=1; fi
  if test "$STOP_OK" -eq 0; then wait_service_running "$OLD_PID" || STOP_OK=1; fi
  resume_watchdogs
  if test "$STOP_OK" -eq 0; then
    remove_runtime_markers
  fi
  trap - EXIT INT TERM
  test "$STOP_OK" -ne 0 || { test "${1:-}" = --purge && rm -rf "$STATE"; }
  test "$STOP_OK" -eq 0 || { echo "Stopfehler: Detach fehlgeschlagen oder phnixIot4G-PID geändert" >&2; return 7; }
  echo stopped
}

startup_failed() {
  echo "Startfehler: $1" >&2
  echo "Startfehler: $1" >> "$STATE/helper.log"
  emergency_cleanup
  exit 6
}

append_hook() {
  ID=$1
  PROTOCOL= DIRECTION= CHANNEL= PTR= LENGTH= BODY=
  case "$ID" in
    mqtt_tx_update) ADDR=0x1F6FC; PROTOCOL=mqtt; DIRECTION=tx; CHANNEL=user/update; PTR='$r0'; LENGTH='$r1' ;;
    mqtt_rx_get) ADDR=0x1EED0; PROTOCOL=mqtt; DIRECTION=rx; CHANNEL=user/get; PTR='*(unsigned int *)(*(unsigned int *)($r2+4)+0x10)'; LENGTH='*(unsigned int *)(*(unsigned int *)($r2+4)+0x08)' ;;
    mqtt_rx_ota) ADDR=0x1ED98; PROTOCOL=mqtt; DIRECTION=rx; CHANNEL=ota; PTR='*(unsigned int *)(*(unsigned int *)($r2+4)+0x10)'; LENGTH='*(unsigned int *)(*(unsigned int *)($r2+4)+0x08)' ;;
    mqtt_tx_ota) ADDR=0x1F9B0; PROTOCOL=mqtt; DIRECTION=tx; CHANNEL=ota_update; PTR='$r0'; LENGTH='$r1' ;;
    http_ota_chunk) ADDR=0x19A54; BODY='printf "FOX|hook_hit|http_ota_chunk|len=%u|ptr=0x%x\n",$r1*$r2,$r0' ;;
    ota_start_mainboard) ADDR=0x19E70; BODY='printf "FOX|hook_hit|ota_start_mainboard|len=0|ptr=0x0\n"' ;;
    ota_start_dtu) ADDR=0x19C18; BODY='printf "FOX|hook_hit|ota_start_dtu|len=0|ptr=0x0\n"' ;;
    provision_linked_go_query) ADDR=0x16960; BODY='printf "FOX|hook_hit|provision_linked_go_query|len=%u|ptr=0x0\n",$r1*$r2' ;;
    provision_legacy_query) ADDR=0x15C58; BODY='printf "FOX|hook_hit|provision_legacy_query|len=%u|ptr=0x0\n",$r1*$r2' ;;
    provision_create_by_sign) ADDR=0x164AC; BODY='printf "FOX|hook_hit|provision_create_by_sign|len=0|ptr=0x0\n"' ;;
    provision_aliyun_register) ADDR=0x22FF4; BODY='printf "FOX|hook_hit|provision_aliyun_register|len=0|ptr=0x0\n"' ;;
    provision_aliyun_register_response) ADDR=0x22B9C; BODY='printf "FOX|hook_hit|provision_aliyun_register_response|len=0|ptr=0x0\n"' ;;
    *) echo "Unbekannte Hook-ID: $ID" >&2; return 2 ;;
  esac
  test -z "${SEEN:-}" || case ",$SEEN," in *,$ID,*) return 0;; esac
  SEEN=${SEEN:+$SEEN,}$ID
  echo "$ID" >> "$STATE/hooks"
  if test "${PROTOCOL:-}" = mqtt && test "$PAYLOAD_MODE" = full; then
    BODY="set \$fox_ptr=$PTR
set \$fox_len=$LENGTH
if \$fox_ptr != 0 && \$fox_len >= 0 && \$fox_len <= 65536
 append binary memory $STATE/payload.bin \$fox_ptr \$fox_ptr+\$fox_len
 printf \"FOXBIN|$PROTOCOL|$DIRECTION|$CHANNEL|%u|%u|0x%x\\n\",\$fox_len,\$fox_payload_offset,\$fox_ptr
 set \$fox_payload_offset=\$fox_payload_offset+\$fox_len
else
 printf \"FOX|hook_hit|$ID|len=%u|ptr=0x%x\\n\",\$fox_len,\$fox_ptr
end"
  elif test "${PROTOCOL:-}" = mqtt; then
    BODY="printf \"FOX|hook_hit|$ID|len=%u|ptr=0x%x\\n\",$LENGTH,$PTR"
  fi
  cat >> "$STATE/trace.gdb" <<EOF
break *$ADDR
commands
 silent
 $BODY
 continue
end
EOF
}

start_trace() {
  HOOKS=""
  while test "$#" -gt 0; do
    case "$1" in
      --hook) test "$#" -ge 2 || unsupported "--hook benötigt eine ID"; HOOKS="$HOOKS $2"; shift 2 ;;
      --hooks) test "$#" -ge 2 || unsupported "--hooks benötigt IDs"; HOOKS="$HOOKS $(echo "$2" | tr ',' ' ')"; shift 2 ;;
      --mode) test "$#" -ge 2 || unsupported "--mode benötigt einen Wert"; PAYLOAD_MODE=$2; shift 2 ;;
      --max-seconds) test "$#" -ge 2 || unsupported "--max-seconds benötigt einen Wert"; MAX_TRACE_SECONDS=$2; shift 2 ;;
      *) unsupported "unerwarteter Startparameter: $1" ;;
    esac
  done
  case "$PAYLOAD_MODE" in metadata_only|preview|full) ;; *) unsupported "unbekannter Payload-Modus" ;; esac
  case "$MAX_TRACE_SECONDS" in *[!0-9]*|'') unsupported "ungültige maximale Laufzeit" ;; esac
  test "$MAX_TRACE_SECONDS" -ge 15 && test "$MAX_TRACE_SECONDS" -le 600 \
    || unsupported "maximale Laufzeit muss zwischen 15 und 600 Sekunden liegen"
  test -n "$HOOKS" || unsupported "kein Hook ausgewählt"
  mkdir -p "$STATE"
  recover_stale_markers
  remove_runtime_markers
  OLD_RUN_ID=$(cat "$RUN_ID_FILE" 2>/dev/null || true)
  if test -n "$OLD_RUN_ID"; then
    ARCHIVE="$STATE/archive/$OLD_RUN_ID"; mkdir -p "$ARCHIVE"
    for LOG in helper.log gdbserver.log gdb.log raw.log failure hooks trace.gdb; do
      test ! -e "$STATE/$LOG" || mv "$STATE/$LOG" "$ARCHIVE/$LOG"
    done
  fi
  RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  echo "$RUN_ID" > "$RUN_ID_FILE"
  rm -f "$STATE/failure"
  : > "$STATE/hooks"; : > "$STATE/trace.gdb"; : > "$STATE/helper.log"; : > "$STATE/payload.bin"
  printf 'run_id=%s start\n' "$RUN_ID" >> "$STATE/helper.log"
  SEEN=""
  # Validate and generate every breakpoint before any debugger attach.
  for ID in $HOOKS; do append_hook "$ID" || { remove_runtime_markers; exit 2; }; done
  command -v gdb >/dev/null && command -v gdbserver >/dev/null || startup_failed "gdb/gdbserver fehlt"
  PID=$(pid_of_service); test -n "$PID" || startup_failed "phnixIot4G inaktiv"
  verify_running_binary "$PID"
  emergency_cleanup
  mkdir -p "$STATE"
  # append_hook output survived cleanup because cleanup intentionally retains diagnostics.
  cat > "$STATE/header.gdb" <<'EOF'
set architecture arm
set target-async on
set pagination off
set confirm off
set print thread-events off
set auto-load safe-path /
set libthread-db-search-path /lib
file /data/phnixIot4G
set logging file /data/local/tmp/foxair-traffic/raw.log
set logging overwrite on
set logging redirect on
set logging on
target remote 127.0.0.1:12346
set $fox_payload_offset=0
EOF
  cat "$STATE/trace.gdb" >> "$STATE/header.gdb"
  cat >> "$STATE/header.gdb" <<EOF
printf "FOX|run_started|run_id=$RUN_ID\\n"
EOF
  mv "$STATE/header.gdb" "$STATE/trace.gdb"
  test "$PID" = "$(pid_of_service)" || unsupported "phnixIot4G-PID hat sich vor Attach geändert"
  verify_running_binary "$PID"
  trap emergency_cleanup EXIT INT TERM
  freeze_watchdogs
  printf 'run_id=%s\n' "$RUN_ID" > "$STATE/gdbserver.log"
  nohup gdbserver --attach 127.0.0.1:12346 "$PID" </dev/null >>"$STATE/gdbserver.log" 2>&1 & echo $! > "$STATE/gdbserver.pid"
  sleep 1
  kill -0 "$(cat "$STATE/gdbserver.pid")" 2>/dev/null || startup_failed "gdbserver beendet"
  printf 'run_id=%s\n' "$RUN_ID" > "$STATE/gdb.log"
  rm -f "$GDB_INPUT"; mkfifo "$GDB_INPUT"
  nohup gdb -q -x "$STATE/trace.gdb" <"$GDB_INPUT" >>"$STATE/gdb.log" 2>&1 & echo $! > "$STATE/gdb.pid"
  exec 3>"$GDB_INPUT"
  printf 'continue&\n' >&3
  sleep 1
  kill -0 "$(cat "$STATE/gdb.pid")" 2>/dev/null || startup_failed "gdb beendet"
  test "$PID" = "$(pid_of_service)" && kill -0 "$PID" 2>/dev/null || startup_failed "PID nach Breakpoint-Installation geändert"
  echo "$PID" > "$STATE/service.pid"
  echo "$MAX_TRACE_SECONDS" > "$STATE/max-seconds"
  echo $(( $(date +%s) + MAX_TRACE_SECONDS )) > "$STATE/deadline"
  touch "$STATE/active"
  test "$PID" = "$(pid_of_service)" && kill -0 "$PID" 2>/dev/null || startup_failed "PID nach continue geändert"
  trap - EXIT INT TERM
  echo "active|run_id=$RUN_ID|watchdogs=guarded|max_seconds=$MAX_TRACE_SECONDS"
}

serve_trace() {
  start_trace "$@" || return $?
  echo $$ > "$STATE/guardian.pid"
  trap emergency_cleanup HUP INT TERM
  monitor_trace
  trap - HUP INT TERM
}

status_trace() {
  if test -r "$STATE/failure"; then cat "$STATE/failure"; return; fi
  if test -r "$STATE/stopping"; then echo "stopping|run_id=$(cat "$RUN_ID_FILE" 2>/dev/null)"; return; fi
  if test -r "$STATE/active" && test "$(cat "$STATE/service.pid" 2>/dev/null)" = "$(pid_of_service)" \
    && kill -0 "$(cat "$STATE/gdbserver.pid")" 2>/dev/null && kill -0 "$(cat "$STATE/gdb.pid")" 2>/dev/null; then
    echo "active|run_id=$(cat "$RUN_ID_FILE" 2>/dev/null)|watchdogs=guarded|max_seconds=$(cat "$STATE/max-seconds" 2>/dev/null || echo "$MAX_TRACE_SECONDS")"
  else
    echo inactive
  fi
}

case "${1:-}" in
  start|serve) shift; serve_trace "$@" ;;
  monitor) monitor_trace ;;
  stop) shift; stop_trace "$@" ;;
  status) status_trace ;;
  *) echo "usage: $0 {start --hook ID [--hook ID ...] [--mode metadata_only] [--max-seconds 15..600]|stop [--purge]|status}" >&2; exit 2 ;;
esac
