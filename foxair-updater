#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MANIFEST_TOOL="$ROOT_DIR/tools/phnix_ota/create_firmware_manifest.py"
AUTONOMOUS="$ROOT_DIR/updater/linux/autonomous_update.py"
ORIGINAL_STATE="$ROOT_DIR/updater/dtu_ota/original_state.py"
REMOTE_ACCESS="$ROOT_DIR/updater/linux/remote_access.sh"
ADB_BIN="${FOX_AIR_ADB:-adb}"
FIRMWARE_DIR="$ROOT_DIR/firmware"
DOWNLOAD_DIR="$ROOT_DIR/downloaded_firmware"
LOG_DIR="$ROOT_DIR/logs"
REMOTE_CACHE="/cache/phnixIot_device_OTA"

# Wenn der integrierte Remote-ADB-Dienst läuft, verwendet auch der lokale
# Linux-Updater genau diesen Server. So konkurrieren nicht zwei ADB-Server
# (5037/5038) um dasselbe USB-Modem.
if [[ -z "${ADB_SERVER_SOCKET:-}" && "$(uname -s 2>/dev/null || true)" == "Linux" ]] \
   && command -v systemctl >/dev/null 2>&1 \
   && systemctl is-active --quiet foxair-adb-remote.service 2>/dev/null; then
    export ADB_SERVER_SOCKET="tcp:127.0.0.1:5038"
fi

# Portable canonical-path helper: GNU readlink -f exists on Linux, but BSD
# readlink on macOS lacks -f. Prefer realpath (brew coreutils or /bin/realpath),
# fall back to a tiny python3 resolver so ./foxair-updater works on macOS.
abspath() {
    if command -v realpath >/dev/null 2>&1; then
        realpath "$1"
    elif readlink -f "$1" >/dev/null 2>&1; then
        readlink -f "$1"
    else
        python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$1"
    fi
}

usage() {
    cat <<'TXT'
FoxAir Updater

Verwendung:
  ./foxair-updater status
  ./foxair-updater check MANIFEST
  ./foxair-updater update MANIFEST [--confirm]
  ./foxair-updater restore
  ./foxair-updater download
  ./foxair-updater manifest FIRMWARE [--full] [--show] [--software-code CODE] [--display-version VERSION] [--target-ssid 0063]
  ./foxair-updater remote {start|stop|restart|status|enable|disable}
  ./foxair-updater version

MANIFEST und FIRMWARE können als Pfad angegeben werden. Wird nur ein Dateiname
angegeben, wird automatisch im lokalen Ordner ./firmware/ gesucht.

Beispiele:
  ./foxair-updater status
  ./foxair-updater check FW3.5.json
  ./foxair-updater update FW3.5.json
  ./foxair-updater update FW3.5.json --confirm
  ./foxair-updater download
  ./foxair-updater manifest FW3.5.bin --full
  ./foxair-updater manifest FW3.5.bin --full --show
  ./foxair-updater remote status
  ./foxair-updater remote enable

remote steuert den integrierten Netzwerkzugriff des Raspberry Pi:
ADB auf TCP 5038 und den ausschließlich lesenden PHNIX-Debugstrom auf TCP 5039.
Der Debug-Port wird anhand USB VID 1e0e / PID 9001 / Interface 04 automatisch
gefunden; eine feste /dev/ttyUSB-Nummer ist nicht erforderlich.

Bei update ist die vollständige Firmware-/Manifestprüfung immer aktiv und kann
nicht abgeschaltet werden. --full ist deshalb dort nicht mehr erforderlich.

Der normale Updatepfad verwendet den autonomen DTU-Runner. Nach dem Start läuft
der Mainboard-OTA auf dem LTE-Modem unabhängig von der Host-/ADB-Verbindung.
Eine bereits installierte identische Firmware wird automatisch erkannt; ein
separater same-version-Befehl ist nicht erforderlich.

Ohne --confirm fragt update interaktiv vor dem Start nach. Für einen bewusst
nicht-interaktiven Start kann --confirm weiterhin verwendet werden.

Nach success oder same-version wird zuerst ein lokales Diagnosearchiv unter
./logs/ erzeugt und verifiziert. Erst danach werden das terminale Ergebnis
bestätigt und die zu diesem Lauf gehörenden FoxAir-Updater-Daten vom LTE-Modem
entfernt. Bei Fehler-/Recovery-Zuständen bleiben die DTU-Diagnosedaten erhalten.

--full beim Manifest-Befehl extrahiert SoftwareCode und Wire-Version direkt aus
der Firmwaredatei und plausibilisiert das Cortex-M-Image. target_ssid ist fuer
FoxAir fest 0063 (Modbus Unit-ID 0x63).

--show erzeugt dasselbe Manifest nur im Speicher und gibt das JSON auf stdout
aus. Es wird dabei keine Manifestdatei geschrieben.

Der Befehl download liest die aktuell im LTE-Cache vorhandene Mainboard-Firmware
sowie wichtige LTE-/OTA-Dateien aus und speichert sie unter
./downloaded_firmware/<Zeitstempel>/. Auf dem Modem wird dabei nichts veraendert.

restore verwendet denselben gemeinsamen Runtime-Hook wie der autonome Runner.
Ein Restore ist nur vor der Uebernahme des Firmwaretransfers durch den
Originaldienst zulaessig; ab transfer_started/original_service_owns wird
fail-closed abgebrochen.

Beim Manifest-Befehl wird ohne --show die JSON-Datei standardmaessig neben der
Firmware mit dem gleichen Basisnamen angelegt, z. B. FW3.5.bin -> FW3.5.json.
TXT
}

die() {
    printf '[FEHLER] %s\n' "$*" >&2
    exit 1
}

warn() {
    printf '[WARNUNG] %s\n' "$*" >&2
}

require_adb() {
    command -v "$ADB_BIN" >/dev/null 2>&1 || die "ADB wurde nicht gefunden: $ADB_BIN (Linux: android-tools-adb installieren; macOS: brew install android-platform-tools)"
}

remote_file_exists() {
    local remote="$1"
    local state
    state="$("$ADB_BIN" shell "if [ -f '$remote' ]; then echo PRESENT; else echo ABSENT; fi" </dev/null 2>/dev/null | tr -d '\r')" \
        || die "ADB-Verbindung zum LTE-Modem ist beim Pruefen von $remote fehlgeschlagen"
    case "$state" in
        PRESENT) return 0 ;;
        ABSENT) return 1 ;;
        *) die "Unerwartete ADB-Antwort beim Pruefen von $remote: ${state:-<leer>}" ;;
    esac
}

download_device_files() {
    local stamp dest pulled remote name
    stamp="$(date '+%Y%m%d-%H%M%S')"
    dest="$DOWNLOAD_DIR/$stamp"
    mkdir -p "$dest"
    pulled=0

    printf '[..] Sichere LTE-Dateien nach %s\n' "$dest"

    while IFS='|' read -r remote name; do
        [[ -n "$remote" ]] || continue
        if remote_file_exists "$remote"; then
            "$ADB_BIN" pull "$remote" "$dest/$name" </dev/null >/dev/null \
                || die "Datei konnte nicht gesichert werden: $remote"
            printf '[OK] %s\n' "$remote"
            pulled=$((pulled + 1))
        else
            if [[ "$remote" == "$REMOTE_CACHE" ]]; then
                warn "Keine Mainboard-Firmware im LTE-Cache gefunden: $REMOTE_CACHE"
            else
                warn "Datei auf dem LTE-Modem nicht gefunden: $remote"
            fi
        fi
    done <<EOF
$REMOTE_CACHE|phnixIot_device_OTA
/data/phnixIot4G|phnixIot4G
/data/phnixIot_device_OTA_INFO|phnixIot_device_OTA_INFO
/data/phnixIot_device_statisic|phnixIot_device_statisic
EOF

    (( pulled > 0 )) || die "Keine der erwarteten LTE-Dateien konnte gefunden werden"

    (
        cd "$dest"
        if command -v md5sum >/dev/null 2>&1; then
            md5sum phnixIot* 2>/dev/null > MD5SUMS.txt || true
        else
            md5 -r phnixIot* 2>/dev/null > MD5SUMS.txt || true
        fi
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum phnixIot* 2>/dev/null > SHA256SUMS.txt || true
        else
            shasum -a 256 phnixIot* 2>/dev/null > SHA256SUMS.txt || true
        fi
    )

    cat > "$dest/README.txt" <<EOF
FoxAir LTE backup
Created: $(date --iso-8601=seconds 2>/dev/null || date)
Source device: PHNIX/FoxAir LTE modem via ADB

Expected source paths:
  /cache/phnixIot_device_OTA
  /data/phnixIot4G
  /data/phnixIot_device_OTA_INFO
  /data/phnixIot_device_statisic

The backup command only used adb pull/read operations on the LTE modem.
EOF

    printf '\n[OK] Sicherung abgeschlossen: %s\n' "$dest"
    printf '     Dateien: %d plus Pruefsummen/README\n' "$pulled"
}

resolve_manifest() {
    local input="${1:-}"
    [[ -n "$input" ]] || die "Manifest fehlt. Beispiel: ./foxair-updater check FW3.4.json"

    if [[ -f "$input" ]]; then
        abspath "$input"
        return
    fi
    if [[ -f "$FIRMWARE_DIR/$input" ]]; then
        abspath "$FIRMWARE_DIR/$input"
        return
    fi
    die "Manifest nicht gefunden: $input (auch nicht unter $FIRMWARE_DIR/)"
}

resolve_firmware() {
    local input="${1:-}"
    [[ -n "$input" ]] || die "Firmware fehlt. Beispiel: ./foxair-updater manifest FW3.4.bin ..."

    if [[ -f "$input" ]]; then
        abspath "$input"
        return
    fi
    if [[ -f "$FIRMWARE_DIR/$input" ]]; then
        abspath "$FIRMWARE_DIR/$input"
        return
    fi
    die "Firmware nicht gefunden: $input (auch nicht unter $FIRMWARE_DIR/)"
}

resolve_manifest_firmware() {
    local manifest="$1"
    local firmware_name
    firmware_name="$(python3 - "$manifest" <<'PY'
import json
import sys
from pathlib import Path
p = Path(sys.argv[1])
try:
    value = json.loads(p.read_text(encoding="utf-8"))
    name = value["firmware_file"]
except Exception as exc:
    raise SystemExit(f"ungueltiges Manifest: {exc}")
if Path(name).name != name:
    raise SystemExit("firmware_file muss ein einfacher Dateiname sein")
print(name)
PY
)" || die "Firmware-Dateiname konnte nicht aus dem Manifest gelesen werden"

    if [[ -f "$(dirname "$manifest")/$firmware_name" ]]; then
        abspath "$(dirname "$manifest")/$firmware_name"
        return
    fi
    if [[ -f "$FIRMWARE_DIR/$firmware_name" ]]; then
        abspath "$FIRMWARE_DIR/$firmware_name"
        return
    fi
    die "Zum Manifest gehoerende Firmware nicht gefunden: $firmware_name"
}

full_manifest_preflight() {
    local manifest="$1"
    local firmware tmp
    [[ -f "$MANIFEST_TOOL" ]] || die "Manifest-Werkzeug fehlt: $MANIFEST_TOOL"
    firmware="$(resolve_manifest_firmware "$manifest")"
    tmp="$(mktemp)"

    if ! python3 "$MANIFEST_TOOL" --firmware "$firmware" --full --output "$tmp" >/dev/null; then
        rm -f "$tmp"
        die "Vollanalyse der Firmware ist fehlgeschlagen"
    fi

    if ! python3 - "$manifest" "$tmp" <<'PY'
import json
import sys
from pathlib import Path
expected = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
detected = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
fields = (
    "schema", "firmware_file", "software_code", "display_version", "wire_version",
    "target_ssid", "size", "md5", "sha256", "image_base",
)
errors = []
for field in fields:
    if expected.get(field) != detected.get(field):
        errors.append(f"{field}: Manifest={expected.get(field)!r}, Firmware={detected.get(field)!r}")
if errors:
    print("[FEHLER] Manifest stimmt nicht mit der analysierten Firmware ueberein:", file=sys.stderr)
    for item in errors:
        print(f"  - {item}", file=sys.stderr)
    raise SystemExit(1)
PY
    then
        rm -f "$tmp"
        die "Vollanalyse der Firmware abgebrochen"
    fi

    rm -f "$tmp"
    printf '[OK] Vollanalyse: Firmwareidentitaet, Groesse und Hashes stimmen mit dem Manifest ueberein\n'
}

[[ -f "$AUTONOMOUS" ]] || die "Autonomer Linux-Updater fehlt: $AUTONOMOUS"
[[ -f "$ORIGINAL_STATE" ]] || die "Originalzustands-Core fehlt: $ORIGINAL_STATE"
command -v python3 >/dev/null 2>&1 || die "python3 wurde nicht gefunden"

command="${1:---help}"
case "$command" in
    -h|--help|help)
        usage
        ;;
    status)
        [[ $# -eq 1 ]] || die "status benoetigt keine weiteren Argumente"
        require_adb
        exec python3 "$AUTONOMOUS" \
            --adb "$ADB_BIN" \
            --logs-dir "$LOG_DIR" \
            --root-dir "$ROOT_DIR" \
            status
        ;;
    check)
        [[ $# -eq 2 ]] || die "Verwendung: ./foxair-updater check MANIFEST"
        manifest="$(resolve_manifest "$2")"
        full_manifest_preflight "$manifest"
        require_adb
        exec python3 "$AUTONOMOUS" \
            --adb "$ADB_BIN" \
            --logs-dir "$LOG_DIR" \
            --root-dir "$ROOT_DIR" \
            check --manifest "$manifest"
        ;;
    update)
        [[ $# -ge 2 && $# -le 3 ]] || die "Verwendung: ./foxair-updater update MANIFEST [--confirm]"
        if [[ $# -eq 3 && "$3" != "--confirm" ]]; then
            die "Unbekannte update-Option: $3"
        fi
        manifest="$(resolve_manifest "$2")"
        full_manifest_preflight "$manifest"
        require_adb
        autonomous_args=(
            python3 "$AUTONOMOUS"
            --adb "$ADB_BIN"
            --logs-dir "$LOG_DIR"
            --root-dir "$ROOT_DIR"
            update --manifest "$manifest"
        )
        if [[ $# -eq 3 ]]; then
            autonomous_args+=(--yes)
        fi
        exec "${autonomous_args[@]}"
        ;;
    restore)
        [[ $# -eq 1 ]] || die "restore benoetigt keine weiteren Argumente"
        require_adb
        exec python3 "$ORIGINAL_STATE" \
            --adb "$ADB_BIN" \
            --execute \
            --confirm FOXAIR-RESTORE-ORIGINAL \
            restore
        ;;
    download)
        [[ $# -eq 1 ]] || die "download benoetigt keine weiteren Argumente"
        require_adb
        download_device_files
        ;;
    remote)
        [[ "$(uname -s 2>/dev/null || true)" == "Linux" ]] || die "remote ist nur unter Linux/Raspberry Pi verfügbar"
        [[ -x "$REMOTE_ACCESS" ]] || die "Remotezugriffs-Helfer fehlt: $REMOTE_ACCESS"
        shift
        exec "$REMOTE_ACCESS" "$@"
        ;;
    manifest)
        [[ $# -ge 2 ]] || die "Verwendung: ./foxair-updater manifest FIRMWARE [--full] [--show] [--software-code CODE --display-version VERSION]"
        [[ -f "$MANIFEST_TOOL" ]] || die "Manifest-Werkzeug fehlt: $MANIFEST_TOOL"
        firmware="$(resolve_firmware "$2")"
        shift 2

        output_seen=0
        show_seen=0
        for arg in "$@"; do
            case "$arg" in
                --output|--output=*) output_seen=1 ;;
                --show) show_seen=1 ;;
            esac
        done

        if (( show_seen == 1 && output_seen == 1 )); then
            die "--show und --output koennen nicht gemeinsam verwendet werden"
        fi

        if (( show_seen == 1 )); then
            exec python3 "$MANIFEST_TOOL" --firmware "$firmware" "$@"
        fi

        if (( output_seen == 0 )); then
            output="${firmware%.*}.json"
            exec python3 "$MANIFEST_TOOL" --firmware "$firmware" "$@" --output "$output"
        else
            exec python3 "$MANIFEST_TOOL" --firmware "$firmware" "$@"
        fi
        ;;
    version)
        [[ $# -eq 1 ]] || die "version benoetigt keine weiteren Argumente"
        printf 'FoxAir Updater %s\n' "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
        ;;
    *)
        die "Unbekannter Befehl: $command. Hilfe: ./foxair-updater --help"
        ;;
esac
