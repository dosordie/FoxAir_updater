#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTROLLER="$ROOT_DIR/tools/phnix_ota/phnix_local_ota_controller.py"
MANIFEST_TOOL="$ROOT_DIR/tools/phnix_ota/create_firmware_manifest.py"
ADB_BIN="${FOX_AIR_ADB:-adb}"
STATE_DIR="$ROOT_DIR/phnix-ota-state"
FIRMWARE_DIR="$ROOT_DIR/firmware"
DOWNLOAD_DIR="$ROOT_DIR/downloaded_firmware"
CACHE_BACKUP_DIR="$STATE_DIR/original-cache"
REMOTE_CACHE="/cache/phnixIot_device_OTA"

usage() {
    cat <<'TXT'
FoxAir Updater

Verwendung:
  ./foxair-updater status
  ./foxair-updater check MANIFEST
  ./foxair-updater update MANIFEST [--full] --confirm
  ./foxair-updater same-version MANIFEST --confirm
  ./foxair-updater restore
  ./foxair-updater download
  ./foxair-updater manifest FIRMWARE [--full] [--show] [--software-code CODE] [--display-version VERSION] [--target-ssid 0063]
  ./foxair-updater version

MANIFEST und FIRMWARE können als Pfad angegeben werden. Wird nur ein Dateiname
angegeben, wird automatisch im lokalen Ordner ./firmware/ gesucht.

Beispiele:
  ./foxair-updater status
  ./foxair-updater check FW3.4.json
  ./foxair-updater update FW3.4.json --confirm
  ./foxair-updater update FW3.4.json --full --confirm
  ./foxair-updater same-version FW3.3.json --confirm
  ./foxair-updater download
  ./foxair-updater manifest FW3.4.bin --full
  ./foxair-updater manifest FW3.4.bin --full --show
  ./foxair-updater manifest FW3.4.bin --software-code 82400644 --display-version V3.4 --show

--full beim Manifest-Befehl extrahiert SoftwareCode und Wire-Version direkt aus
der Firmwaredatei und plausibilisiert das Cortex-M-Image. target_ssid ist fuer
FoxAir fest 0063 (Modbus Unit-ID 0x63).

--show erzeugt dasselbe Manifest nur im Speicher und gibt das JSON auf stdout
aus. Es wird dabei keine Manifestdatei geschrieben.

--full beim Update analysiert die zum Manifest gehoerende Firmware erneut und
vergleicht die extrahierte Identitaet sowie Dateigroesse und Hashes strikt mit
dem Manifest, bevor ADB oder Busaktivitaet beginnt.

Der Befehl download liest die aktuell im LTE-Cache vorhandene Mainboard-Firmware
sowie wichtige LTE-/OTA-Dateien aus und speichert sie unter
./downloaded_firmware/<Zeitstempel>/. Auf dem Modem wird dabei nichts veraendert.

Vor update und same-version wird eine eventuell vorhandene Originaldatei
/cache/phnixIot_device_OTA zusaetzlich intern gesichert. same-version stellt sie
nach erfolgreicher Gleichversionsablehnung wieder her; restore stellt sie nach
einem bestaetigten Pre-C5A8-Recovery wieder auf den Ausgangszustand zurueck.

Beim Manifest-Befehl wird ohne --show die JSON-Datei standardmaessig neben der
Firmware mit dem gleichen Basisnamen angelegt, z. B. FW3.4.bin -> FW3.4.json.
TXT
}

die() {
    printf '[FEHLER] %s\n' "$*" >&2
    exit 1
}

warn() {
    printf '[WARNUNG] %s\n' "$*" >&2
}

require_adb() {
    command -v "$ADB_BIN" >/dev/null 2>&1 || die "ADB wurde nicht gefunden: $ADB_BIN"
}

remote_file_exists() {
    local remote="$1"
    local state
    state="$("$ADB_BIN" shell "if [ -f '$remote' ]; then echo PRESENT; else echo ABSENT; fi" 2>/dev/null | tr -d '\r')" \
        || die "ADB-Verbindung zum LTE-Modem ist beim Pruefen von $remote fehlgeschlagen"
    case "$state" in
        PRESENT) return 0 ;;
        ABSENT) return 1 ;;
        *) die "Unerwartete ADB-Antwort beim Pruefen von $remote: ${state:-<leer>}" ;;
    esac
}

backup_update_cache() {
    mkdir -p "$CACHE_BACKUP_DIR"
    rm -f \
        "$CACHE_BACKUP_DIR/phnixIot_device_OTA" \
        "$CACHE_BACKUP_DIR/cache.present" \
        "$CACHE_BACKUP_DIR/cache.absent" \
        "$CACHE_BACKUP_DIR/MD5" \
        "$CACHE_BACKUP_DIR/SHA256"

    if remote_file_exists "$REMOTE_CACHE"; then
        "$ADB_BIN" pull "$REMOTE_CACHE" "$CACHE_BACKUP_DIR/phnixIot_device_OTA" >/dev/null \
            || die "Vorhandene Cache-Firmware konnte vor dem OTA nicht gesichert werden"
        md5sum "$CACHE_BACKUP_DIR/phnixIot_device_OTA" | awk '{print $1}' > "$CACHE_BACKUP_DIR/MD5"
        sha256sum "$CACHE_BACKUP_DIR/phnixIot_device_OTA" | awk '{print $1}' > "$CACHE_BACKUP_DIR/SHA256"
        touch "$CACHE_BACKUP_DIR/cache.present"
        printf '[OK] Vorhandene LTE-Cache-Firmware vor dem OTA gesichert\n'
    else
        touch "$CACHE_BACKUP_DIR/cache.absent"
        printf '[..] Vor dem OTA war keine Firmware unter %s vorhanden\n' "$REMOTE_CACHE"
    fi
}

restore_update_cache() {
    [[ -d "$CACHE_BACKUP_DIR" ]] || return 0

    if [[ -f "$CACHE_BACKUP_DIR/cache.present" ]]; then
        local backup expected remote_hash
        backup="$CACHE_BACKUP_DIR/phnixIot_device_OTA"
        [[ -f "$backup" ]] || die "Cache-Backup-Marker vorhanden, aber Sicherungsdatei fehlt"
        expected="$(cat "$CACHE_BACKUP_DIR/SHA256")"

        "$ADB_BIN" push "$backup" /cache/.phnixIot_device_OTA.restore >/dev/null \
            || die "Cache-Firmware konnte nicht zum LTE-Modem zurueckkopiert werden"
        remote_hash="$("$ADB_BIN" shell "sha256sum /cache/.phnixIot_device_OTA.restore | awk '{print \$1}'" | tr -d '\r')"
        [[ "$remote_hash" == "$expected" ]] || die "SHA-256 der zurueckkopierten Cache-Firmware stimmt nicht"
        "$ADB_BIN" shell "mv /cache/.phnixIot_device_OTA.restore '$REMOTE_CACHE' && sync" >/dev/null \
            || die "Cache-Firmware konnte nicht atomar wiederhergestellt werden"
        remote_hash="$("$ADB_BIN" shell "sha256sum '$REMOTE_CACHE' | awk '{print \$1}'" | tr -d '\r')"
        [[ "$remote_hash" == "$expected" ]] || die "SHA-256 der wiederhergestellten Cache-Firmware stimmt nicht"
        printf '[OK] Urspruengliche LTE-Cache-Firmware wiederhergestellt\n'
        return 0
    fi

    if [[ -f "$CACHE_BACKUP_DIR/cache.absent" ]]; then
        "$ADB_BIN" shell "rm -f '$REMOTE_CACHE' /cache/.phnixIot_device_OTA.restore && sync" >/dev/null \
            || die "Urspruenglich leeren Cache-Zustand konnte nicht wiederhergestellt werden"
        printf '[OK] Urspruenglicher leerer LTE-Cache-Zustand wiederhergestellt\n'
    fi
}

download_device_files() {
    local stamp dest pulled remote name
    stamp="$(date '+%Y%m%d-%H%M%S')"
    dest="$DOWNLOAD_DIR/$stamp"
    mkdir -p "$dest"
    pulled=0

    printf '[..] Sichere LTE-Dateien nach %s\n' "$dest"

    while IFS='|' read -r remote name; do
        [[ -n "$remote" ]] || continue
        if remote_file_exists "$remote"; then
            "$ADB_BIN" pull "$remote" "$dest/$name" >/dev/null \
                || die "Datei konnte nicht gesichert werden: $remote"
            printf '[OK] %s\n' "$remote"
            pulled=$((pulled + 1))
        else
            if [[ "$remote" == "$REMOTE_CACHE" ]]; then
                warn "Keine Mainboard-Firmware im LTE-Cache gefunden: $REMOTE_CACHE"
            else
                warn "Datei auf dem LTE-Modem nicht gefunden: $remote"
            fi
        fi
    done <<EOF
$REMOTE_CACHE|phnixIot_device_OTA
/data/phnixIot4G|phnixIot4G
/data/phnixIot_device_OTA_INFO|phnixIot_device_OTA_INFO
/data/phnixIot_device_statisic|phnixIot_device_statisic
EOF

    (( pulled > 0 )) || die "Keine der erwarteten LTE-Dateien konnte gefunden werden"

    (
        cd "$dest"
        md5sum phnixIot* 2>/dev/null > MD5SUMS.txt || true
        sha256sum phnixIot* 2>/dev/null > SHA256SUMS.txt || true
    )

    cat > "$dest/README.txt" <<EOF
FoxAir LTE backup
Created: $(date --iso-8601=seconds 2>/dev/null || date)
Source device: PHNIX/FoxAir LTE modem via ADB

Expected source paths:
  /cache/phnixIot_device_OTA
  /data/phnixIot4G
  /data/phnixIot_device_OTA_INFO
  /data/phnixIot_device_statisic

The backup command only used adb pull/read operations on the LTE modem.
EOF

    printf '\n[OK] Sicherung abgeschlossen: %s\n' "$dest"
    printf '     Dateien: %d plus Pruefsummen/README\n' "$pulled"
}

resolve_manifest() {
    local input="${1:-}"
    [[ -n "$input" ]] || die "Manifest fehlt. Beispiel: ./foxair-updater check FW3.4.json"

    if [[ -f "$input" ]]; then
        readlink -f "$input"
        return
    fi
    if [[ -f "$FIRMWARE_DIR/$input" ]]; then
        readlink -f "$FIRMWARE_DIR/$input"
        return
    fi
    die "Manifest nicht gefunden: $input (auch nicht unter $FIRMWARE_DIR/)"
}

resolve_firmware() {
    local input="${1:-}"
    [[ -n "$input" ]] || die "Firmware fehlt. Beispiel: ./foxair-updater manifest FW3.4.bin ..."

    if [[ -f "$input" ]]; then
        readlink -f "$input"
        return
    fi
    if [[ -f "$FIRMWARE_DIR/$input" ]]; then
        readlink -f "$FIRMWARE_DIR/$input"
        return
    fi
    die "Firmware nicht gefunden: $input (auch nicht unter $FIRMWARE_DIR/)"
}

resolve_manifest_firmware() {
    local manifest="$1"
    local firmware_name
    firmware_name="$(python3 - "$manifest" <<'PY'
import json
import sys
from pathlib import Path
p = Path(sys.argv[1])
try:
    value = json.loads(p.read_text(encoding="utf-8"))
    name = value["firmware_file"]
except Exception as exc:
    raise SystemExit(f"ungueltiges Manifest: {exc}")
if Path(name).name != name:
    raise SystemExit("firmware_file muss ein einfacher Dateiname sein")
print(name)
PY
)" || die "Firmware-Dateiname konnte nicht aus dem Manifest gelesen werden"

    if [[ -f "$(dirname "$manifest")/$firmware_name" ]]; then
        readlink -f "$(dirname "$manifest")/$firmware_name"
        return
    fi
    if [[ -f "$FIRMWARE_DIR/$firmware_name" ]]; then
        readlink -f "$FIRMWARE_DIR/$firmware_name"
        return
    fi
    die "Zum Manifest gehoerende Firmware nicht gefunden: $firmware_name"
}

full_manifest_preflight() {
    local manifest="$1"
    local firmware tmp
    [[ -f "$MANIFEST_TOOL" ]] || die "Manifest-Werkzeug fehlt: $MANIFEST_TOOL"
    firmware="$(resolve_manifest_firmware "$manifest")"
    tmp="$(mktemp)"

    if ! python3 "$MANIFEST_TOOL" --firmware "$firmware" --full --output "$tmp" >/dev/null; then
        rm -f "$tmp"
        die "Vollanalyse der Firmware ist fehlgeschlagen"
    fi

    if ! python3 - "$manifest" "$tmp" <<'PY'
import json
import sys
from pathlib import Path
expected = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
detected = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
fields = (
    "schema", "firmware_file", "software_code", "display_version", "wire_version",
    "target_ssid", "size", "md5", "sha256", "image_base",
)
errors = []
for field in fields:
    if expected.get(field) != detected.get(field):
        errors.append(f"{field}: Manifest={expected.get(field)!r}, Firmware={detected.get(field)!r}")
if errors:
    print("[FEHLER] Manifest stimmt nicht mit der analysierten Firmware ueberein:", file=sys.stderr)
    for item in errors:
        print(f"  - {item}", file=sys.stderr)
    raise SystemExit(1)
PY
    then
        rm -f "$tmp"
        die "--full Vorpruefung abgebrochen"
    fi

    rm -f "$tmp"
    printf '[OK] Vollanalyse: Firmwareidentitaet, Groesse und Hashes stimmen mit dem Manifest ueberein\n'
}

[[ -f "$CONTROLLER" ]] || die "Controller fehlt: $CONTROLLER"
command -v python3 >/dev/null 2>&1 || die "python3 wurde nicht gefunden"

command="${1:---help}"
case "$command" in
    -h|--help|help)
        usage
        ;;
    status)
        [[ $# -eq 1 ]] || die "status benoetigt keine weiteren Argumente"
        require_adb
        exec python3 "$CONTROLLER" --adb "$ADB_BIN" run --check status
        ;;
    check)
        [[ $# -eq 2 ]] || die "Verwendung: ./foxair-updater check MANIFEST"
        require_adb
        manifest="$(resolve_manifest "$2")"
        exec python3 "$CONTROLLER" --adb "$ADB_BIN" run --manifest "$manifest"
        ;;
    update)
        [[ $# -ge 3 && $# -le 4 ]] || die "Verwendung: ./foxair-updater update MANIFEST [--full] --confirm"
        manifest="$(resolve_manifest "$2")"
        full=0
        confirm=0
        for arg in "${@:3}"; do
            case "$arg" in
                --full) full=1 ;;
                --confirm) confirm=1 ;;
                *) die "Unbekannte update-Option: $arg" ;;
            esac
        done
        (( confirm == 1 )) || die "Update benoetigt --confirm"
        if (( full == 1 )); then
            full_manifest_preflight "$manifest"
        fi
        require_adb
        backup_update_cache
        exec python3 "$CONTROLLER" \
            --adb "$ADB_BIN" \
            run \
            --manifest "$manifest" \
            --execute \
            --confirm PHNIX-FULL-UPDATE \
            --state-dir "$STATE_DIR"
        ;;
    same-version)
        [[ $# -eq 3 && "$3" == "--confirm" ]] || die "Verwendung: ./foxair-updater same-version MANIFEST --confirm"
        require_adb
        manifest="$(resolve_manifest "$2")"
        backup_update_cache
        if python3 "$CONTROLLER" \
            --adb "$ADB_BIN" \
            same-version-test \
            --manifest "$manifest" \
            --execute \
            --confirm PHNIX-C350-SAME-V33 \
            --logger-confirm PASSIVE-LOGGER-RUNNING \
            --state-dir "$STATE_DIR"; then
            restore_update_cache
            exit 0
        else
            rc=$?
            warn "Gleichversionstest nicht sicher terminal beendet; Cache wird nicht automatisch veraendert. Bei bestaetigtem Pre-C5A8-Zustand ./foxair-updater restore verwenden."
            exit "$rc"
        fi
        ;;
    restore)
        [[ $# -eq 1 ]] || die "restore benoetigt keine weiteren Argumente"
        require_adb
        if python3 "$CONTROLLER" --adb "$ADB_BIN" run --restore original; then
            restore_update_cache
            exit 0
        else
            rc=$?
            exit "$rc"
        fi
        ;;
    download)
        [[ $# -eq 1 ]] || die "download benoetigt keine weiteren Argumente"
        require_adb
        download_device_files
        ;;
    manifest)
        [[ $# -ge 2 ]] || die "Verwendung: ./foxair-updater manifest FIRMWARE [--full] [--show] [--software-code CODE --display-version VERSION]"
        [[ -f "$MANIFEST_TOOL" ]] || die "Manifest-Werkzeug fehlt: $MANIFEST_TOOL"
        firmware="$(resolve_firmware "$2")"
        shift 2

        output_seen=0
        show_seen=0
        for arg in "$@"; do
            case "$arg" in
                --output|--output=*) output_seen=1 ;;
                --show) show_seen=1 ;;
            esac
        done

        if (( show_seen == 1 && output_seen == 1 )); then
            die "--show und --output koennen nicht gemeinsam verwendet werden"
        fi

        if (( show_seen == 1 )); then
            exec python3 "$MANIFEST_TOOL" --firmware "$firmware" "$@"
        fi

        if (( output_seen == 0 )); then
            output="${firmware%.*}.json"
            exec python3 "$MANIFEST_TOOL" --firmware "$firmware" "$@" --output "$output"
        else
            exec python3 "$MANIFEST_TOOL" --firmware "$firmware" "$@"
        fi
        ;;
    version)
        [[ $# -eq 1 ]] || die "version benoetigt keine weiteren Argumente"
        printf 'FoxAir Updater %s\n' "$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
        ;;
    *)
        die "Unbekannter Befehl: $command. Hilfe: ./foxair-updater --help"
        ;;
esac
